<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
	<dict>
		<key>CFBundleDevelopmentRegion</key>
		<string>$(DEVELOPMENT_LANGUAGE)</string>
		<key>CFBundleDisplayName</key>
		<string>Quran Time</string>
		<key>CFBundleExecutable</key>
		<string>$(EXECUTABLE_NAME)</string>
		<key>CFBundleIdentifier</key>
		<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
		<key>CFBundleInfoDictionaryVersion</key>
		<string>6.0</string>
		<key>CFBundleName</key>
		<string>quran_time</string>
		<key>CFBundlePackageType</key>
		<string>APPL</string>
		<key>CFBundleShortVersionString</key>
		<string>$(FLUTTER_BUILD_NAME)</string>
		<key>CFBundleSignature</key>
		<string>????</string>
		<key>CFBundleVersion</key>
		<string>$(FLUTTER_BUILD_NUMBER)</string>
		<key>LSRequiresIPhoneOS</key>
		<true/>
		<key>UILaunchStoryboardName</key>
		<string>LaunchScreen</string>
		<key>UIMainStoryboardFile</key>
		<string>Main</string>
		<key>UISupportedInterfaceOrientations</key>
		<array>
			<string>UIInterfaceOrientationPortrait</string>
			<string>UIInterfaceOrientationLandscapeLeft</string>
			<string>UIInterfaceOrientationLandscapeRight</string>
		</array>
		<key>UISupportedInterfaceOrientations~ipad</key>
		<array>
			<string>UIInterfaceOrientationPortrait</string>
			<string>UIInterfaceOrientationPortraitUpsideDown</string>
			<string>UIInterfaceOrientationLandscapeLeft</string>
			<string>UIInterfaceOrientationLandscapeRight</string>
		</array>
		<key>CADisableMinimumFrameDurationOnPhone</key>
		<true/>
		<key>UIApplicationSupportsIndirectInputEvents</key>
		<true/>
		<key>UIStatusBarHidden</key>
		<false/>

		<!-- 🔔 NOTIFICATION PERMISSIONS FOR QURAN REMINDERS -->
		<key>UIBackgroundModes</key>
		<array>
			<string>background-processing</string>
			<!-- Added: Equivalent to Android's boot completed and exact alarms -->
			<string>background-app-refresh</string>
		</array>

		<!-- Notification permission description (already present) -->
		<key>NSUserNotificationsUsageDescription</key>
		<string>Quran Timer needs permission to send you daily Quran reading reminders to help maintain your spiritual routine.</string>

		<!-- Background task identifiers (already present) -->
		<key>BGTaskSchedulerPermittedIdentifiers</key>
		<array>
			<string>com.quran.reminder</string>
		</array>

		<!-- 📳 HAPTIC FEEDBACK PERMISSION -->
		<!-- iOS equivalent to Android's VIBRATE permission -->
		<!-- Note: No explicit permission needed in Info.plist for haptic feedback -->
		<!-- Haptic feedback is available by default in iOS -->

		<!-- 🔄 BOOT/RESTART HANDLING -->
		<!-- iOS equivalent to Android's RECEIVE_BOOT_COMPLETED -->
		<!-- This is handled through background app refresh capability above -->
		
		<!-- ⏰ EXACT TIMING PERMISSIONS -->
		<!-- iOS equivalent to Android's USE_EXACT_ALARM and SCHEDULE_EXACT_ALARM -->
		<!-- iOS doesn't require explicit permission for local notifications with exact timing -->
		<!-- But we ensure critical alerts capability if needed -->
		<key>UIApplicationExitsOnSuspend</key>
		<false/>

		<!-- 📱 ARABIC TEXT SUPPORT (already present) -->
		<key>CFBundleAllowMixedLocalizations</key>
		<true/>
		<key>CFBundleLocalizations</key>
		<array>
			<string>en</string>
			<string>ar</string>
		</array>

		<!-- 🎯 ADDITIONAL iOS-SPECIFIC CAPABILITIES -->
		<!-- Support for critical notifications (similar to exact alarms) -->
		<key>UNNotificationSoundName</key>
		<string>default</string>
		
		<!-- Allow app to continue running for notifications -->
		<key>UIRequiredDeviceCapabilities</key>
		<array>
			<string>armv7</string>
		</array>
	</dict>
</plist>